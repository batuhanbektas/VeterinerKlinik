@model Clinic
@{
    ViewData["Title"] = "Yeni Klinik";
    Layout = "_AdminLayout";
}

<h1 class="h3 mb-3">Yeni Klinik</h1>

<div class="card col-lg-6">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="OpeningTime" class="form-label"></label>
                    <input asp-for="OpeningTime" type="time" asp-format="{0:HH:mm}" class="form-control" />
                    <span asp-validation-for="OpeningTime" class="text-danger small"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="ClosingTime" class="form-label"></label>
                    <input asp-for="ClosingTime" type="time" asp-format="{0:HH:mm}" class="form-control" />
                    <span asp-validation-for="ClosingTime" class="text-danger small"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
